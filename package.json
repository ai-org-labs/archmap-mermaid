{
  "name": "@archmap/mermaid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build -c vite.config.site.ts && node tools/build-standalone.mjs",
    "preview": "vite preview -c vite.config.site.ts --host 127.0.0.1",
    "build:library": "vite build -c vite.config.library.ts",
    "verify": "npm run typecheck && npm test && npm run build && npm run build:library && node tools/verify-site.mjs"
  },
  "dependencies": {
    "@archmap/icons": "file:vendor/archmap-icons-0.1.3.tgz",
    "js-yaml": "^4.3.2",
    "mermaid": "12.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.0.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  }
}
